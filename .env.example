# Langfuse (create a project "lumen" at http://localhost:3000 -> Settings -> API keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Optional overrides
# LUMEN_MODEL=qwen3.5:2b   # fallback: hf.co/XHToken/Spark-X2.5-4B-GGUF:Q4_K_M
# LUMEN_NUM_CTX=8192
# LUMEN_CPU_ONLY=1        # run models on CPU only (GPU stays asleep)
# LUMEN_POWER=auto         # auto | saver | performance
